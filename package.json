{
  "name": "kindergarten-score-manager",
  "version": "1.1.0",
  "description": "ប្រព័ន្ធគ្រប់គ្រងពិន្ទុសិស្សថ្នាក់មត្តេយ្យភាសាចិន | Chinese Kindergarten Score Management Desktop System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "kindergarten",
    "score-management",
    "cambodia",
    "chinese-school",
    "electron",
    "desktop-app"
  ],
  "author": "Pei Hua Chinese School",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "build": {
    "appId": "com.peihua.kindergartenscoremanager",
    "productName": "គ្រប់គ្រងពិន្ទុមត្តេយ្យ 华文幼儿园成绩系统",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/images/school-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "គ្រប់គ្រងពិន្ទុមត្តេយ្យ 华文幼儿园"
    }
  }
}
